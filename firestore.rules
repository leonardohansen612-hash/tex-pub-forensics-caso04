rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /caso05_dossiers/{docId} {
      allow create: if request.resource.data.keys().hasAll(['team','report','status','deviceId'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.team is string
                    && request.resource.data.report is string;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
